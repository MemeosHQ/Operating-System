# MEMEOS environment
# ── MEMEOS environment ────────────────────────────────────────────
# Data mode. MEMEOS_DEMO_MODE (server) wins, then NEXT_PUBLIC_DATA_MODE.
#   MEMEOS_DEMO_MODE=true  → demo (deterministic sample data, clearly labeled)
#   MEMEOS_DEMO_MODE=false → live (real APIs; unconfigured features fail honestly)
NEXT_PUBLIC_DATA_MODE=demo
# MEMEOS_DEMO_MODE (server-only, wins over NEXT_PUBLIC_DATA_MODE):
#   true  = deterministic demo data, clearly labeled
#   false = live providers (Helius, DexScreener, Pump.fun, Postgres)
MEMEOS_DEMO_MODE=true
# MEMEOS_DEMO_MODE=true

# ── Solana RPC (client-safe) ──────────────────────────────────────
# Empty = official public RPC fallback (rate-limited, fine for health checks)
NEXT_PUBLIC_SOLANA_RPC_URL=

# Cluster wallets connect on (must match the RPC endpoint): mainnet-beta | devnet | testnet
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# ── Public / keyless market data (client-safe) ────────────────────
NEXT_PUBLIC_DEXSCREENER_API_URL=https://api.dexscreener.com

# ── Server-only secrets — read ONLY inside /api route handlers. ───
# NEVER prefix these with NEXT_PUBLIC_. Nothing here reaches the browser bundle.

# Helius — primary production Solana provider (RPC + DAS getAsset + Enhanced
# Transactions). Gates REAL wallet intelligence and first-60s launch replay.
HELIUS_API_KEY=

# Optional: Birdeye API — real holder counts / top-holder quality for Meme DNA.
BIRDEYE_API_KEY=

# ── AI (optional — RESERVED, not yet consumed by code) ────────────
# Gemini powers the LLM MemeOS Analyst (server-side only). Without a key the
# deterministic rule-engine Analyst answers - never broken, never faked.
GEMINI_API_KEY=
# Current default model per official docs (gemini-2.x is shut down).
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Optional persistence (Postgres) ───────────────────────────────
# Not required for v1 (watchlists persist in localStorage). Reserved for
# server-side watchlists, snapshot history and wallet-graph relationships.
DATABASE_URL=

# --- $MEMEOS token (public information - a mint address is not a secret) ---
# Official $MEMEOS contract/mint address. Empty or TBA = not announced yet -
# the UI shows TBA with copy/buy disabled. Set the real CA to activate
# copy / Solscan / buy automatically (validated as a Solana public key).
NEXT_PUBLIC_MEMEOS_TOKEN_CA=
# Official buy destination (Jupiter/Raydium/launch page URL). Empty = Coming Soon.
NEXT_PUBLIC_MEMEOS_BUY_URL=

